<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera: AR alignment + vision segmentation + OCR input -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Microphone: acoustic tap diagnostic -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- IR blaster: AC functional verification. iQOO 15 has this hardware (verified);
         require=false so the app installs on devices without it, with the IR module
         degrading gracefully at runtime (see IrController). -->
    <uses-feature android:name="android.hardware.consumerir" android:required="false" />

    <!-- Required by ConsumerIrManager.transmit(), regardless of whether the emitter hardware
         is present; without it every transmit() call throws SecurityException. That is
         exactly what happened on the judging-representative handset before this line existed:
         `adb shell pm list features` confirmed FEATURE_CONSUMER_IR present, but the merged
         manifest never declared this permission, so every "Trigger AC over IR" tap threw,
         IrController.transmit caught it as a Failure, and the appliance check was silently
         recorded as "not functional", a tool failure billed as a real defect. TRANSMIT_IR is
         a normal, install-time permission (protectionLevel="normal"); declaring it here is
         sufficient, no runtime grant or request is needed. -->
    <uses-permission android:name="android.permission.TRANSMIT_IR" />

    <!-- Nothing else beyond what follows is declared. ACCESS_FINE_LOCATION and VIBRATE were
         declared for features that were never built (no code path ever set
         InspectionEntity's latitude/longitude, and there is no Vibrator call anywhere), so
         the app was prompting for precise location on a privacy-first pitch and never using
         it. Those two stay removed.

         INTERNET and ACCESS_NETWORK_STATE, below, are different: the product owner has
         explicitly decided this app now syncs signed findings reports to a backend
         (see com.smartlease.edge.sync), so the app genuinely reaches the network and these
         permissions are real, not a merge artifact to suppress.

         Before this change the app genuinely had no network access, and it is worth being
         precise about why, because the reason is about to stop applying.
         com.google.mlkit:text-recognition pulls in
         com.google.android.datatransport:transport-backend-cct (ML Kit's own telemetry
         uploader), and that library's own manifest declares both permissions. The
         `tools:node="remove"` that used to sit on the two lines below existed precisely to
         strip them back out, and it worked: measured on 2026-09-12, the pre-change merged
         manifest contained zero INTERNET entries, and `dumpsys package com.smartlease.edge`
         against the installed build listed only TRANSMIT_IR, CAMERA, RECORD_AUDIO and an
         internal broadcast permission. The OCR model itself is bundled on-device and never
         phones home; only its unused CCT transport ever wanted the socket. That history matters for the
         privacy story the sync feature still owes: com.smartlease.edge.sync sends only a
         SHA-256 digest and small metadata (never photos, video, or audio, and never a
         bitmap/byte-array field on its wire types), but ML Kit's own CCT transport is a
         separate, unaudited path onto the same two permissions and is not covered by that
         guarantee. If the sync feature is ever removed or gated off, reinstate
         `tools:node="remove"` on both lines below rather than deleting them, so a dependency
         bump cannot silently reopen network access the app no longer intends to use. Verify
         against the merged manifest
         (app/build/intermediates/merged_manifest/debug/processDebugMainManifest/AndroidManifest.xml)
         if that is ever in doubt. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/smartlease_edge_logo"
        android:roundIcon="@drawable/smartlease_edge_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartLeaseEdge"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The only way anything leaves this app, and it is user-initiated every time:
             a share sheet for one report PDF. exported=false plus per-Intent read grants,
             scoped by @xml/file_paths to filesDir/reports/ only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
