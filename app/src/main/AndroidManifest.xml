<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera: AR alignment + vision segmentation + OCR input -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Microphone: acoustic tap diagnostic -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- IR blaster: AC functional verification. iQOO 15 has this hardware (verified);
         require=false so the app installs on devices without it, with the IR module
         degrading gracefully at runtime (see IrController). -->
    <uses-feature android:name="android.hardware.consumerir" android:required="false" />

    <!-- Nothing else is declared. ACCESS_FINE_LOCATION and VIBRATE were declared for
         features that were never built (no code path ever set InspectionEntity's
         latitude/longitude, and there is no Vibrator call anywhere), so the app was
         prompting for precise location on a privacy-first pitch and never using it.
         INTERNET is, and stays, undeclared. -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartLeaseEdge"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The only way anything leaves this app, and it is user-initiated every time:
             a share sheet for one report PDF. exported=false plus per-Intent read grants,
             scoped by @xml/file_paths to filesDir/reports/ only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
