<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera: AR alignment + vision segmentation + OCR input -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Microphone: acoustic tap diagnostic -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- IR blaster: AC functional verification. iQOO 15 has this hardware (verified);
         require=false so the app installs on devices without it, with the IR module
         degrading gracefully at runtime (see IrController). -->
    <uses-feature android:name="android.hardware.consumerir" android:required="false" />

    <!-- Required by ConsumerIrManager.transmit(), regardless of whether the emitter hardware
         is present; without it every transmit() call throws SecurityException. That is
         exactly what happened on the judging-representative handset before this line existed:
         `adb shell pm list features` confirmed FEATURE_CONSUMER_IR present, but the merged
         manifest never declared this permission, so every "Trigger AC over IR" tap threw,
         IrController.transmit caught it as a Failure, and the appliance check was silently
         recorded as "not functional", a tool failure billed as a real defect. TRANSMIT_IR is
         a normal, install-time permission (protectionLevel="normal"); declaring it here is
         sufficient, no runtime grant or request is needed. -->
    <uses-permission android:name="android.permission.TRANSMIT_IR" />

    <!-- Nothing else is declared. ACCESS_FINE_LOCATION and VIBRATE were declared for
         features that were never built (no code path ever set InspectionEntity's
         latitude/longitude, and there is no Vibrator call anywhere), so the app was
         prompting for precise location on a privacy-first pitch and never using it.

         INTERNET and ACCESS_NETWORK_STATE are never declared by any source file here
         either, but they were showing up granted on the installed build anyway:
         com.google.mlkit:text-recognition pulls in
         com.google.android.datatransport:transport-backend-cct, ML Kit's own telemetry
         uploader, which merges both permissions in regardless of what this manifest asks
         for. The OCR model itself is bundled on-device and never phones home — only its
         unused CCT transport wanted the socket. Merger, not code, was granting network
         access on a build whose entire pitch is that it can't. The removals below are
         therefore load-bearing, not decorative: a future dependency bump (ML Kit, or
         anything else pulling in transport-backend-cct) can silently reintroduce either
         permission, and without this explicit `tools:node="remove"` it will merge back in
         unnoticed. Verify against the merged manifest
         (app/build/intermediates/merged_manifest/debug/processDebugMainManifest/AndroidManifest.xml),
         not this source file, if that is ever in doubt. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartLeaseEdge"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The only way anything leaves this app, and it is user-initiated every time:
             a share sheet for one report PDF. exported=false plus per-Intent read grants,
             scoped by @xml/file_paths to filesDir/reports/ only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
